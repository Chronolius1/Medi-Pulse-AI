# Copy to .env (git-ignored) for local dev, or set the same names in Vercel
# (Project → Settings → Environment Variables).
#
# MediPulse is a static Vite app: anything prefixed VITE_ is inlined into the
# browser bundle at build time and is therefore visible to anyone who loads the
# site. Only put a key here that you are comfortable exposing client-side
# (e.g. one restricted by HTTP referrer in Google AI Studio / Cloud Console).

# Default Google Gemini key. When set, a first-time visitor starts on the
# Gemini provider with this key already filled in. A key the user pastes in
# Settings always wins over this one.
VITE_GEMINI_API_KEY=
